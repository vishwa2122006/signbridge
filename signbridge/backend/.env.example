# Copy to backend/.env and fill in. Real environment variables override this file.

# PostgreSQL. Tables are created when the API starts.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/sign_bridge
# Used only by the test suite, which WIPES this database on every run. Never point it at real data.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/sign_bridge_test

# Login tokens. Use a long random string, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it logs everyone out.
JWT_SECRET=
JWT_EXPIRE_HOURS=24

# One-time codes sent by email (registration and login)
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60

# Email. For Gmail: turn on 2-Step Verification, create an app password at
# https://myaccount.google.com/apppasswords and put it in SMTP_PASSWORD.
# With SMTP_PASSWORD empty, emails (including login codes) are printed in the backend console instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
MAIL_FROM=you@gmail.com
MAIL_FROM_NAME=SignBridge

# Where the frontend runs, for links in emails
FRONTEND_URL=http://localhost:5173
# Comma-separated origins allowed to call the API, or *
CORS_ORIGINS=*
